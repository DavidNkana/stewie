# Stewie — Evolution API backed WhatsApp bot
# Copy to .env and fill in. Never commit .env.

# --- Evolution API transport ---
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=stewie

# --- Stewie service ---
STEWIE_PORT=8099
STEWIE_WEBHOOK_TOKEN=
STEWIE_ADMIN_TOKEN=
STEWIE_STATE_FILE=data/state.json
STEWIE_LOG_LEVEL=info

# --- Model (OpenAI-compatible) ---
# gpt-5.6-luna: STEWIE_MODEL_BASE_URL=https://api.openai.com/v1
# MiniMax-M3:   STEWIE_MODEL_BASE_URL=https://api.minimax.io/v1
STEWIE_MODEL_API_KEY=
STEWIE_MODEL_BASE_URL=https://api.openai.com/v1
STEWIE_MODEL=gpt-5.6-luna

# --- Behaviour ---
STEWIE_BOT_NAME=stewie
STEWIE_BOT_ALIASES=
# Per-chat persona override; keep empty to use the default voice
STEWIE_PERSONA=
# never | mention | question | always
STEWIE_GROUP_MODE=mention
STEWIE_DM_MODE=always
STEWIE_COOLDOWN_SECONDS=20
STEWIE_MAX_REPLIES_PER_CHAT_PER_HOUR=20
STEWIE_MAX_REPLIES_PER_HOUR=60
STEWIE_RESPONSE_PROBABILITY=1
STEWIE_HISTORY_SIZE=20
STEWIE_RETENTION_DAYS=7
